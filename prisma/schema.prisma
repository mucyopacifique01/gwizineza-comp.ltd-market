generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Seller {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  businessName String
  ownerName    String
  phone        String
  email        String?
  address      String?
  loginUsername String?
  passwordHash String?
  status       SellerStatus @default(PENDING)
  products     Product[]
  createdAt    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([businessName])
  @@index([loginUsername])
}

model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  sku         String         @unique
  name        String
  slug        String         @unique
  description String?
  priceRwf    Int
  stock       Int            @default(0)
  imageUrl    String?
  isActive    Boolean        @default(true)
  // Storefront merchandising (all optional so existing MongoDB documents stay valid)
  compareAtPriceRwf Int?
  isFeatured        Boolean?
  displaySection    String?
  displayPriority   Int?
  categoryId  String?        @db.ObjectId
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sellerId    String?        @db.ObjectId
  seller      Seller?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  reviews      ProductReview[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([sellerId])
}

model ProductImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime  @updatedAt
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
}

enum OrderStatus {
  ORDERED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String      @unique
  status          OrderStatus @default(ORDERED)
  customerName    String
  phone           String
  customerEmail   String?
  customerId      String?      @db.ObjectId
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryAddress String
  subtotalRwf     Int
  deliveryRwf     Int         @default(0)
  totalRwf        Int
  currency        String      @default("RWF")
  payment         Payment?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([phone])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String  @db.ObjectId
  productId    String  @db.ObjectId
  sellerId     String? @db.ObjectId
  productName  String
  unitPriceRwf Int
  quantity     Int
  lineTotalRwf Int
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([sellerId])
}

model Customer {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?
  phone        String?
  passwordHash String?
  googleId     String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  wishlistItems WishlistItem[]
  reviews      ProductReview[]
  tickets      SupportTicket[]
}

model SiteSettings {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  key                 String   @unique
  siteName            String
  tagline             String
  location            String
  region              String
  phone               String?
  email               String?
  whatsapp            String?
  copyrightText       String
  copyrightYear       Int
  footerCredit        String
  announcementText    String?
  announcementEnabled Boolean  @default(true)
  mapLat              Float?
  mapLng              Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  COD
  MOMO
  AIRTEL
  CARD
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @db.ObjectId
  productId  String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

model ProductReview {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  productId  String       @db.ObjectId
  customerId String?      @db.ObjectId
  orderId    String?      @db.ObjectId
  rating     Int
  title      String?
  body       String?
  status     ReviewStatus @default(PENDING)
  verified   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([customerId])
}

model SupportTicket {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String?        @db.ObjectId
  sellerId    String?        @db.ObjectId
  subject     String
  message     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  email       String?
  phone       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([sellerId, status])
}

model ContentPost {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  slug        String        @unique
  title       String
  excerpt     String?
  body        String
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model DeliveryZone {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  name           String  @unique
  feeRwf         Int     @default(0)
  etaMinDays     Int     @default(1)
  etaMaxDays     Int     @default(3)
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String        @unique @db.ObjectId
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountRwf   Int
  currency    String        @default("RWF")
  provider    String?
  providerRef String?
  metadata    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, method])
  @@index([providerRef])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([actorType, actorId])
  @@index([entityType, entityId])
}
