DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-host.onrender.com
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_SSL_REQUIRE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.example
CSRF_TRUSTED_ORIGINS=https://your-backend-host.onrender.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose-to-browser
