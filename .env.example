# NEXT.JS FRONTEND (.env.local at repository root)
# Local Django service URL. In production Render injects this from the Django service.
DJANGO_API_URL=http://127.0.0.1:8000

# Public Supabase project settings, safe to expose in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_EBM_ENABLED=false

# DJANGO BACKEND (backend/.env locally; backend service environment on Render)
# Copy the PostgreSQL connection string from Supabase -> Connect.
# Prefer the Session Pooler if your host needs IPv4. Require SSL in production.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_PASSWORD=replace-with-a-long-owner-password

# Supabase Auth: OTP send/verify requests are handled by Django and Supabase Auth.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Storage is used for product image uploads; service role stays server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# TextBee + Supabase Auth Send SMS Hook for phone OTP delivery.
TEXTBEE_API_KEY=your-textbee-api-key
TEXTBEE_DEVICE_ID=
SUPABASE_SEND_SMS_HOOK_SECRET=your-supabase-send-sms-hook-signing-secret
