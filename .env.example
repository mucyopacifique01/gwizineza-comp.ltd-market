# Supabase database: use the PostgreSQL connection string from Project Settings > Database.
# For long-running Django web services, prefer the Supabase session pooler URL if direct IPv6 is unavailable.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require"

# Supabase Auth + product image storage
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Django backend (set DJANGO_API_URL on the Next.js service)
DJANGO_API_URL="http://127.0.0.1:8000"
DJANGO_SECRET_KEY="replace-with-a-long-random-secret"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,.onrender.com"
DJANGO_CSRF_TRUSTED_ORIGINS=""

# Owner console
ADMIN_PASSWORD="change-this-admin-password"

# Supabase Auth SMS Send Hook -> https://YOUR_DJANGO_API_HOST/api/auth/send-sms-hook
# Configure this hook in Supabase Auth, and use the exact signing secret Supabase gives you.
SUPABASE_SEND_SMS_HOOK_SECRET="v1,whsec_your-supabase-hook-secret"
TEXTBEE_API_KEY="your-textbee-api-key"
TEXTBEE_DEVICE_ID="your-textbee-device-id"

# App URLs
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Public contact options
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_EBM_ENABLED="false"
