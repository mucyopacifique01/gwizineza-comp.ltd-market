# MongoDB Atlas connection string
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/gwizineza?retryWrites=true&w=majority"

# Required for admin login/session signing. Generate a long random secret.
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_SESSION_SECRET="change-this-to-a-long-random-secret"

# Supabase project (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# TextBee SMS gateway for Supabase Phone OTP.
# Keep these server-side secrets out of client-side code.
TEXTBEE_API_KEY="your-textbee-api-key"
TEXTBEE_DEVICE_ID="optional-textbee-device-id"
SUPABASE_SEND_SMS_HOOK_SECRET="your-supabase-send-sms-hook-signing-secret"
